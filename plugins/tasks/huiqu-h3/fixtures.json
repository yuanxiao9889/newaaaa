{
  "cases": [
    {
      "name": "choose final MP4 after intermediate",
      "hook": "parseTaskResult",
      "args": [
        {
          "taskId": "task_upstream"
        },
        {
          "code": "success",
          "data": {
            "task_id": "task_upstream",
            "status": "SUCCESS",
            "data": {
              "results": [
                {
                  "url": "https://cdn.example.com/intermediate.",
                  "outputType": ""
                },
                {
                  "url": "https://cdn.example.com/final.mp4",
                  "outputType": "mp4"
                }
              ]
            },
            "result_url": "https://cdn.example.com/intermediate."
          }
        }
      ],
      "expected": {
        "status": "SUCCESS",
        "progress": "100%",
        "url": "https://cdn.example.com/final.mp4"
      }
    },
    {
      "name": "result order does not matter",
      "hook": "parseTaskResult",
      "args": [
        {
          "taskId": "task_upstream"
        },
        {
          "code": "success",
          "data": {
            "task_id": "task_upstream",
            "status": "SUCCESS",
            "data": {
              "results": [
                {
                  "url": "https://cdn.example.com/final.mp4",
                  "outputType": "mp4"
                },
                {
                  "url": "https://cdn.example.com/intermediate.",
                  "outputType": ""
                }
              ]
            },
            "result_url": "https://cdn.example.com/intermediate."
          }
        }
      ],
      "expected": {
        "status": "SUCCESS",
        "progress": "100%",
        "url": "https://cdn.example.com/final.mp4"
      }
    },
